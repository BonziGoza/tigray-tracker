  "purpose": "A transparent, editable baseline for publisher-level newsroom practices. It is not a verdict on any individual article and does not measure political alignment.",
  "methodology": {
    "dimensions": [
      {
        "name": "accuracy_and_corrections",
        "weight": 30,
        "signals": [
          "published correction policy",
          "clear and timely correction practice"
        ]
      },
      {
        "name": "sourcing_and_verification",
        "weight": 25,
        "signals": [
          "verification standards",
          "clear attribution",
          "original reporting and diverse sources"
        ]
      },
      {
        "name": "editorial_transparency",
        "weight": 20,
        "signals": [
          "bylines and contact details",
          "published editorial standards",
          "ownership and funding disclosure"
        ]
      },
      {
        "name": "editorial_independence",
        "weight": 15,
        "signals": [
          "disclosed ownership/government relationships",
          "editorial safeguards",
          "conflict-of-interest policy"
        ]
      },
      {
        "name": "track_record",
        "weight": 10,
        "signals": [
          "documented original reporting",
          "demonstrated accountability over time"
        ]
      }
    ],
    "interpretation": {
      "80-100": "Strong documented publisher-level practices",
      "65-79": "Generally established publisher-level practices",
      "50-64": "Mixed, provisional, or incompletely documented",
      "0-49": "Documented concerns or significant unresolved questions; explain the evidence",
      "unassessed": "Insufficient information; not automatically unreliable"
    },
    "safeguards": [
      "Apply the same criteria across international, regional, local, and conflict-party media.",
      "A publisher score is not an article truth probability and must not replace article-level evidence.",
      "Do not reduce a score solely for geography, political viewpoint, or language.",
      "Treat ownership and public funding as context requiring disclosure, not automatic proof of unreliability.",
      "Aggregators and syndicated copies are not independent corroboration; identify the original report.",
      "Profiles are provisional until outlet-specific evidence is documented and reviewed."
    ],
    "reference_standards": [
      {
        "name": "Journalism Trust Initiative standard",
        "url": "https://journalismtrustinitiative.org/jti-the-standard/"
      },
      {
        "name": "IPTC trust and credibility indicators",
        "url": "https://iptc.org/std/guidelines/trust-and-credibility/"
      }
    ]
  },
